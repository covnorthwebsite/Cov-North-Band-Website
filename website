  <script>
    document.addEventListener('DOMContentLoaded', () => {

      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileLinks = document.querySelectorAll('.mobile-link');

      mobileMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });

      mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu.classList.add('hidden');
        });
      });

      const filterBtns = document.querySelectorAll('.filter-btn');
      const rosterCards = document.querySelectorAll('.roster-card');

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          filterBtns.forEach(b => {
            b.classList.remove('bg-navy-800', 'text-gold-400', 'shadow-md');
            b.classList.add('bg-gray-200', 'text-navy-800');
          });

          btn.classList.remove('bg-gray-200', 'text-navy-800');
          btn.classList.add('bg-navy-800', 'text-gold-400', 'shadow-md');

          const category = btn.getAttribute('data-filter');

          rosterCards.forEach(card => {
            if (category === 'all' || card.getAttribute('data-category') === category) {
              card.style.display = 'block';
              card.style.opacity = '1';
            } else {
              card.style.display = 'none';
              card.style.opacity = '0';
            }
          });
        });
      });

      let currentRaised = 0;
      const totalTarget = 200;

      window.addPledge = function(amount) {
        currentRaised += amount;
        if (currentRaised > totalTarget) currentRaised = totalTarget;

        const percent = Math.min(100, Math.round((currentRaised / totalTarget) * 100));
        const remaining = Math.max(0, totalTarget - currentRaised);

        document.getElementById('amount-raised-text').innerText = '£' + currentRaised;
        document.getElementById('percent-text').innerText = percent + '% of goal funded';
        document.getElementById('progress-bar-fill').style.width = percent + '%';
        document.getElementById('remaining-text').innerText = '£' + remaining + ' Needed';
      };

      const modal = document.getElementById('donate-modal');
      const openModalBtn = document.getElementById('donate-modal-btn');
      const closeModalBtn = document.getElementById('close-modal-btn');

      openModalBtn.addEventListener('click', () => {
        modal.classList.remove('opacity-0', 'pointer-events-none');
      });

      closeModalBtn.addEventListener('click', () => {
        closeModal();
      });

      window.closeModal = function() {
        modal.classList.add('opacity-0', 'pointer-events-none');
      };

      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      const fullnameInput = document.getElementById('fullname');
      const emailInput = document.getElementById('email');
      const instrumentInput = document.getElementById('instrument');
      const experienceInput = document.getElementById('experience');
      const messageInput = document.getElementById('message');
      const previewBtn = document.getElementById('preview-btn');
      const previewPanel = document.getElementById('preview-panel');

      const prevName = document.getElementById('prev-name');
      const prevEmail = document.getElementById('prev-email');
      const prevInstrument = document.getElementById('prev-instrument');
      const prevExperience = document.getElementById('prev-experience');
      const prevMessage = document.getElementById('prev-message');
      const prevBadge = document.getElementById('preview-badge');

      function updatePreview() {
        prevName.textContent = fullnameInput.value.trim() || 'Not entered yet';
        prevEmail.textContent = emailInput.value.trim() || 'Not entered yet';
        prevInstrument.textContent = instrumentInput.value || 'Not selected';
        prevExperience.textContent = experienceInput.value || 'Beginner';
        prevMessage.textContent = messageInput.value.trim() || 'No notes added.';

        if (fullnameInput.value.trim() && emailInput.value.trim() && instrumentInput.value) {
          prevBadge.textContent = 'Ready to Submit';
          prevBadge.className = 'px-2.5 py-1 bg-green-500/20 text-green-400 text-xs font-bold rounded-full border border-green-500/40';
        } else {
          prevBadge.textContent = 'Draft Mode';
          prevBadge.className = 'px-2.5 py-1 bg-gold-500/20 text-gold-400 text-xs font-bold rounded-full border border-gold-500/40';
        }
      }

      [fullnameInput, emailInput, instrumentInput, experienceInput, messageInput].forEach(elem => {
        elem.addEventListener('input', updatePreview);
        elem.addEventListener('change', updatePreview);
      });

      previewBtn.addEventListener('click', () => {
        updatePreview();
        previewPanel.scrollIntoView({ behavior: 'smooth', block: 'center' });
        previewPanel.classList.add('shadow-gold-glow-lg');
        setTimeout(() => {
          previewPanel.classList.remove('shadow-gold-glow-lg');
        }, 1200);
      });

      let audioCtx = null;

      function getAudioContext() {
        if (!audioCtx) {
          audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        }
        if (audioCtx.state === 'suspended') {
          audioCtx.resume();
        }
        return audioCtx;
      }

      function playSound(type) {
        const ctx = getAudioContext();
        const now = ctx.currentTime;

        if (type === 'snare') {
          const osc = ctx.createOscillator();
          const gainOsc = ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(180, now);
          osc.frequency.exponentialRampToValueAtTime(60, now + 0.1);
          gainOsc.gain.setValueAtTime(0.7, now);
          gainOsc.gain.exponentialRampToValueAtTime(0.01, now + 0.12);
          osc.connect(gainOsc);
          gainOsc.connect(ctx.destination);
          osc.start(now);
          osc.stop(now + 0.12);

          const bufferSize = ctx.sampleRate * 0.15;
          const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
          const data = buffer.getChannelData(0);
          for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;

          const noise = ctx.createBufferSource();
          noise.buffer = buffer;
          const noiseFilter = ctx.createBiquadFilter();
          noiseFilter.type = 'highpass';
          noiseFilter.frequency.value = 1000;
          const gainNoise = ctx.createGain();
          gainNoise.gain.setValueAtTime(0.8, now);
          gainNoise.gain.exponentialRampToValueAtTime(0.01, now + 0.15);

          noise.connect(noiseFilter);
          noiseFilter.connect(gainNoise);
          gainNoise.connect(ctx.destination);
          noise.start(now);

        } else if (type === 'tenor-hi' || type === 'tenor-lo' || type.startsWith('quad')) {
          let freq = 220;
          if (type === 'tenor-hi') freq = 280;
          if (type === 'tenor-lo') freq = 190;
          if (type === 'quad-1') freq = 320;
          if (type === 'quad-2') freq = 240;
          if (type === 'quad-3') freq = 160;

          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, now);
          osc.frequency.exponentialRampToValueAtTime(freq * 0.5, now + 0.18);

          gain.gain.setValueAtTime(0.9, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + 0.2);

          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(now);
          osc.stop(now + 0.2);

        } else if (type === 'bass') {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(110, now);
          osc.frequency.exponentialRampToValueAtTime(35, now + 0.35);

          gain.gain.setValueAtTime(1.0, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + 0.4);

          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(now);
          osc.stop(now + 0.4);

        } else if (type === 'cymbal') {
          const bufferSize = ctx.sampleRate * 0.4;
          const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
          const data = buffer.getChannelData(0);
          for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;

          const noise = ctx.createBufferSource();
          noise.buffer = buffer;
          const filter = ctx.createBiquadFilter();
          filter.type = 'highpass';
          filter.frequency.value = 4500;

          const gain = ctx.createGain();
          gain.gain.setValueAtTime(0.6, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + 0.4);

          noise.connect(filter);
          filter.connect(gain);
          gain.connect(ctx.destination);
          noise.start(now);

        } else if (type === 'rimshot') {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'square';
          osc.frequency.setValueAtTime(400, now);
          osc.frequency.exponentialRampToValueAtTime(120, now + 0.05);

          gain.gain.setValueAtTime(0.9, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + 0.06);

          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(now);
          osc.stop(now + 0.06);
        }
      }

      const drumPads = document.querySelectorAll('.drum-pad');
      drumPads.forEach(pad => {
        const soundType = pad.getAttribute('data-sound');

        const triggerPad = () => {
          playSound(soundType);
          pad.classList.add('pad-pressed');
          setTimeout(() => pad.classList.remove('pad-pressed'), 150);
        };

        pad.addEventListener('click', triggerPad);
      });

      const keyMap = {
        'q': 'snare',
        'w': 'tenor-hi',
        'e': 'tenor-lo',
        'r': 'quad-1',
        't': 'quad-2',
        'y': 'quad-3',
        'a': 'bass',
        's': 'cymbal',
        'd': 'rimshot'
      };

      document.addEventListener('keydown', (e) => {
        if (['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement.tagName)) return;

        const key = e.key.toLowerCase();
        if (keyMap[key]) {
          const sound = keyMap[key];
          playSound(sound);

          const matchingPad = document.querySelector(`.drum-pad[data-sound="${sound}"]`);
          if (matchingPad) {
            matchingPad.classList.add('pad-pressed');
            setTimeout(() => matchingPad.classList.remove('pad-pressed'), 150);
          }
        }
      });

    });
  </script>
